# Copier ce fichier en .env (jamais versionné) puis l'adapter.
ENVIRONMENT=dev
# Obligatoire en production : uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# En développement, laissée vide, une clé est créée une fois dans backend/.secret_key.
SECRET_KEY=
# true dès que l'application est servie en HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
# Le premier compte peut toujours être créé ; les suivants seulement si true
ALLOW_REGISTRATION=false

# SQLite par défaut ; pour PostgreSQL : uv sync --extra postgres, puis
# DATABASE_URL=postgresql+psycopg://pea:motdepasse@localhost:5432/pea_radar
# DATABASE_URL=sqlite:///./pea_radar.db

# yfinance (cours réels) ou synthetic (données fictives pour tester hors ligne)
DATA_PROVIDER=yfinance

# Clé gratuite : https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Nombre d'opportunités retenues et analysées par l'IA à chaque scan
TOP_N=20

DEFAULT_INITIAL_CASH=10000
# Frais par ordre (simulation, plans ETF, backtest) : pourcentage + forfait, avec un minimum.
# 0,005 = 0,5 %. Mettez la grille de votre courtier : sur de petits ordres, un minimum de
# 1 ou 2 € pèse bien plus qu'un pourcentage. Le backtest n'utilise que le pourcentage.
ORDER_FEE_RATE=0.005
ORDER_FEE_MIN=0
ORDER_FEE_FIXED=0

# Diversification : nombre maximal de titres d'un même secteur dans le top
MAX_PER_SECTOR=4

# Scan automatique les jours ouvrés, heure de Paris (vide = désactivé). Le serveur doit tourner.
SCAN_SCHEDULE=18:30
# Nombre de lignes du suivi automatique de la simulation
AUTO_FOLLOW_POSITIONS=5

# Alertes par e-mail (facultatif ; sans SMTP, les alertes restent visibles dans l'application).
# Les alertes partent vers l'adresse du compte. L'expéditeur ne peut PAS être une adresse
# Outlook, Hotmail ou Live : Microsoft a coupé l'authentification par mot de passe pour ces
# comptes en septembre 2024, mots de passe d'application compris.
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_USER=votre adresse, SMTP_PASSWORD=mot de passe
#   d'application de 16 caractères (nécessite la validation en deux étapes).
# Brevo : SMTP_HOST=smtp-relay.brevo.com, identifiants fournis dans l'espace SMTP & API.
# Tester depuis l'écran Compte : « Envoyer un e-mail de test ».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Fiscalité du PEA (taux 2026)
PEA_SOCIAL_RATE=0.186
PEA_INCOME_TAX_RATE=0.128
