# Copier ce fichier en .env (jamais versionné) puis l'adapter.
ENVIRONMENT=dev
# Obligatoire en production : uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true dès que l'application est servie en HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
# Le premier compte peut toujours être créé ; les suivants seulement si true
ALLOW_REGISTRATION=false

# yfinance (cours réels) ou synthetic (données fictives pour tester hors ligne)
DATA_PROVIDER=yfinance

# Clé gratuite : https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

DEFAULT_INITIAL_CASH=10000
ORDER_FEE_RATE=0.005
