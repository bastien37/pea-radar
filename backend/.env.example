# Copier ce fichier en .env (jamais versionné) puis l'adapter.
ENVIRONMENT=dev
# Obligatoire en production : uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true dès que l'application est servie en HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
# Le premier compte peut toujours être créé ; les suivants seulement si true
ALLOW_REGISTRATION=false

# SQLite par défaut ; pour PostgreSQL : uv sync --extra postgres, puis
# DATABASE_URL=postgresql+psycopg://pea:motdepasse@localhost:5432/pea_radar
# DATABASE_URL=sqlite:///./pea_radar.db

# yfinance (cours réels) ou synthetic (données fictives pour tester hors ligne)
DATA_PROVIDER=yfinance

# Clé gratuite : https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Nombre d'opportunités retenues et analysées par l'IA à chaque scan
TOP_N=20

DEFAULT_INITIAL_CASH=10000
ORDER_FEE_RATE=0.005

# Diversification : nombre maximal de titres d'un même secteur dans le top
MAX_PER_SECTOR=4

# Scan automatique les jours ouvrés, heure de Paris (vide = désactivé). Le serveur doit tourner.
SCAN_SCHEDULE=18:30
# Nombre de lignes du suivi automatique de la simulation
AUTO_FOLLOW_POSITIONS=5

# Alertes par e-mail (facultatif ; sans SMTP, les alertes restent visibles dans l'application)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Fiscalité du PEA (taux 2026)
PEA_SOCIAL_RATE=0.186
PEA_INCOME_TAX_RATE=0.128
